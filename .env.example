# Secrets & env — copy to .env and fill in
OPENCODE_ZEN_API_KEY=
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
PAINSCOUT_PROVIDER=nim
PAINSCOUT_LIMIT=15
PAINSCOUT_APP_ID=310633997

# Rotating niche bank (JSON array) — used by `--rotate`
# PAINSCOUT_QUERY_BANK=["wish there was a way to automate","i waste hours every week"]

# Competitor app watch list — scan MANY apps in one run
# ios:<appstore-id>|Name, android:<package-name>
# PAINSCOUT_WATCH_APPS="ios:310633997|WhatsApp, android:com.whatsapp"
